# OpenVideo Studio — Optional Environment Variables
#
# ALL environment variables below are OPTIONAL.
# You do NOT need to create a .env file or enter any API keys to start the app.
# Every setting falls back to safe local defaults automatically, and all core
# video editing and Non-AI clipping work out of the box with zero API keys.
#
# Uncomment any line below only if you want to override a default value locally.

# --- Server & Local Paths (Safe Defaults Shown) ---
# PORT=3000
# STORAGE_DIR="./storage"
# DATABASE_PATH="./data/openvideo.db"

# --- Low-Resource Worker Defaults (8 GB RAM Friendly) ---
# WORKER_CONCURRENCY=1
# FFMPEG_THREADS=2

# --- Local Binary Overrides (Defaults Use System PATH) ---
# FFMPEG_PATH="ffmpeg"
# FFPROBE_PATH="ffprobe"
# YT_DLP_PATH="yt-dlp"

# --- Optional Local AI Providers (Not Required; Enable in AI Providers Tab) ---
# OLLAMA_BASE_URL="http://127.0.0.1:11434"
# LMSTUDIO_BASE_URL="http://127.0.0.1:1234/v1"

# --- Optional Cloud AI Provider Keys (Strictly Server-Side; Never Required) ---
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# CUSTOM_AI_BASE_URL=
# CUSTOM_AI_API_KEY=
